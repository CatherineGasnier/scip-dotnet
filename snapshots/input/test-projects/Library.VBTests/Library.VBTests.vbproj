<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace />
    <!-- Microsoft.Testing.Platform frameworks such as MSTest.Sdk, xunit.v3 and TUnit set this property.
         It is set directly so that this fixture needs no test framework package. -->
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Library\Library.csproj" />
  </ItemGroup>

</Project>
